# Frontend-safe Configuration
# Copy this to .env.local for local overrides. Never include SMTP or admin secrets.

# Leave empty on Vercel to use relative routing /api. For local dev, Vite automatically proxies to http://localhost:5000 if empty.
VITE_API_URL=

# Firebase Web SDK Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Admin Fallback credentials (local-testing mode only)
VITE_ADMIN_EMAIL=admin@yourdomain.com
VITE_ADMIN_PASSWORD=change-me-in-env
